{
  "id": "quit-smoking-free-10",
  "voiceId": "ar-hamed",
  "edgeVoice": "ar-SA-HamedNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 357,
  "chunks": [
    {
      "index": 0,
      "text": "مرحبًا.",
      "file": "c000.ogg",
      "durationSec": 2.952
    },
    {
      "index": 1,
      "text": "هذه التمارين مخصصة لك كشخص لا يدخن.",
      "file": "c001.ogg",
      "durationSec": 7.776
    },
    {
      "index": 2,
      "text": "ابحث عن وضعية مريحة، أو استلقِ إذا شعرت أن ذلك أفضل.",
      "file": "c002.ogg",
      "durationSec": 9.888
    },
    {
      "index": 3,
      "text": "دع يديك تستريح.",
      "file": "c003.ogg",
      "durationSec": 4.32
    },
    {
      "index": 4,
      "text": "خفف من عينيك، أو أغلقها.",
      "file": "c004.ogg",
      "durationSec": 6.0
    },
    {
      "index": 5,
      "text": "خذ نفسًا بطيئًا من خلال الأنف.",
      "file": "c005.ogg",
      "durationSec": 5.688
    },
    {
      "index": 6,
      "text": "وأنفث ببطء وبطولة.",
      "file": "c006.ogg",
      "durationSec": 4.92
    },
    {
      "index": 7,
      "text": "[استراحة:16]",
      "file": "c007.ogg",
      "durationSec": 4.872
    },
    {
      "index": 8,
      "text": "شعر بالجسم مدعومًا.",
      "file": "c008.ogg",
      "durationSec": 4.608
    },
    {
      "index": 9,
      "text": "لا شيء لإثباته. لا مكان للتعجل.",
      "file": "c009.ogg",
      "durationSec": 8.28
    },
    {
      "index": 10,
      "text": "[استراحة:16]",
      "file": "c010.ogg",
      "durationSec": 4.872
    },
    {
      "index": 11,
      "text": "سنعمل مع عبارات واضحة للحرية.",
      "file": "c011.ogg",
      "durationSec": 6.864
    },
    {
      "index": 12,
      "text": "استمع، أو كرر بصمت ما يشعرك بالصدق.",
      "file": "c012.ogg",
      "durationSec": 7.728
    },
    {
      "index": 13,
      "text": "[استراحة:18]",
      "file": "c013.ogg",
      "durationSec": 5.16
    },
    {
      "index": 14,
      "text": "أنا الآن شخص لا يدخن.",
      "file": "c014.ogg",
      "durationSec": 5.064
    },
    {
      "index": 15,
      "text": "[استراحة:16]",
      "file": "c015.ogg",
      "durationSec": 4.872
    },
    {
      "index": 16,
      "text": "أنا سعيد جدًا بالتخلص من مرض النيكوتين.",
      "file": "c016.ogg",
      "durationSec": 7.464
    },
    {
      "index": 17,
      "text": "[استراحة:18]",
      "file": "c017.ogg",
      "durationSec": 5.16
    },
    {
      "index": 18,
      "text": "التدخين لم يعد جزءًا من حياتي أو هويتي.",
      "file": "c018.ogg",
      "durationSec": 7.008
    },
    {
      "index": 19,
      "text": "[استراحة:18]",
      "file": "c019.ogg",
      "durationSec": 5.16
    },
    {
      "index": 20,
      "text": "أنا أشعر بهذه المحفزات بسبب ذكريات الماضي أو رؤية مدخنين آخرين.",
      "file": "c020.ogg",
      "durationSec": 11.256
    },
    {
      "index": 21,
      "text": "[استراحة:18]",
      "file": "c021.ogg",
      "durationSec": 5.16
    },
    {
      "index": 22,
      "text": "هذه المحفزات لا تستطيع فعل أي شيء بي، لأنني حررت نفسي من عبودية الإدمان.",
      "file": "c022.ogg",
      "durationSec": 13.008
    },
    {
      "index": 23,
      "text": "[توقف:22]",
      "file": "c023.ogg",
      "durationSec": 5.712
    },
    {
      "index": 24,
      "text": "أشعر بالأسف على المدخنين الذين ما زالوا عالقين بخدع التدخين.",
      "file": "c024.ogg",
      "durationSec": 9.624
    },
    {
      "index": 25,
      "text": "الذين يقعون في دورة التعاسة من نقص النيكوتين، والرغبة، والتعبئة مرة أخرى.",
      "file": "c025.ogg",
      "durationSec": 12.84
    },
    {
      "index": 26,
      "text": "[توقف:18]",
      "file": "c026.ogg",
      "durationSec": 5.184
    },
    {
      "index": 27,
      "text": "لم أعد أعاني مثلهم.",
      "file": "c027.ogg",
      "durationSec": 4.776
    },
    {
      "index": 28,
      "text": "[توقف:14]",
      "file": "c028.ogg",
      "durationSec": 4.872
    },
    {
      "index": 29,
      "text": "الآن أعرف الحقيقة.",
      "file": "c029.ogg",
      "durationSec": 4.68
    },
    {
      "index": 30,
      "text": "لا يوجد أي فائدة على الإطلاق من التدخين.",
      "file": "c030.ogg",
      "durationSec": 7.44
    },
    {
      "index": 31,
      "text": "[توقف:18]",
      "file": "c031.ogg",
      "durationSec": 5.184
    },
    {
      "index": 32,
      "text": "لم يساعد عصا البول أحدًا أبدًا، ولن يساعد أبدًا.",
      "file": "c032.ogg",
      "durationSec": 8.904
    },
    {
      "index": 33,
      "text": "[توقف:18]",
      "file": "c033.ogg",
      "durationSec": 5.184
    },
    {
      "index": 34,
      "text": "أوجد التدخين الكثير من المشاكل لي.",
      "file": "c034.ogg",
      "durationSec": 6.192
    },
    {
      "index": 35,
      "text": "[توقف:14]",
      "file": "c035.ogg",
      "durationSec": 4.872
    },
    {
      "index": 36,
      "text": "اتخذت أفضل قرار في حياتي بعدم تدخين نفحة أخرى من هذا السم المقرف.",
      "file": "c036.ogg",
      "durationSec": 11.112
    },
    {
      "index": 37,
      "text": "كان هذا القرار نهائيًا.",
      "file": "c037.ogg",
      "durationSec": 5.16
    },
    {
      "index": 38,
      "text": "[توقف:22]",
      "file": "c038.ogg",
      "durationSec": 5.712
    },
    {
      "index": 39,
      "text": "الآن، أحترم قانون التدخين.",
      "file": "c039.ogg",
      "durationSec": 6.696
    },
    {
      "index": 40,
      "text": "[توقف:18]",
      "file": "c040.ogg",
      "durationSec": 5.184
    },
    {
      "index": 41,
      "text": "الآن، أصبحت جميع حالاتي أفضل.",
      "file": "c041.ogg",
      "durationSec": 6.912
    },
    {
      "index": 42,
      "text": "أصبحت أكثر سعادة، وصحة، وثقة.",
      "file": "c042.ogg",
      "durationSec": 7.704
    },
    {
      "index": 43,
      "text": "[توقف:22]",
      "file": "c043.ogg",
      "durationSec": 5.712
    },
    {
      "index": 44,
      "text": "أنا حرّ.",
      "file": "c044.ogg",
      "durationSec": 2.928
    },
    {
      "index": 45,
      "text": "[توقف:28]",
      "file": "c045.ogg",
      "durationSec": 5.952
    },
    {
      "index": 46,
      "text": "استرخِ في هذا الحرية لبضع أنفاس.",
      "file": "c046.ogg",
      "durationSec": 6.936
    },
    {
      "index": 47,
      "text": "قد تزورني المحفزات كذكريات قديمة.",
      "file": "c047.ogg",
      "durationSec": 6.912
    },
    {
      "index": 48,
      "text": "لا يمكنهم إعادتك إلى العبودية.",
      "file": "c048.ogg",
      "durationSec": 6.168
    },
    {
      "index": 49,
      "text": "[توقف:36]",
      "file": "c049.ogg",
      "durationSec": 5.616
    },
    {
      "index": 50,
      "text": "أنا الآن مُمتنع عن التدخين.",
      "file": "c050.ogg",
      "durationSec": 5.376
    },
    {
      "index": 51,
      "text": "أنا حر.",
      "file": "c051.ogg",
      "durationSec": 2.928
    },
    {
      "index": 52,
      "text": "[توقف:28]",
      "file": "c052.ogg",
      "durationSec": 5.952
    },
    {
      "index": 53,
      "text": "خذ نفسًا سهلًا آخر.",
      "file": "c053.ogg",
      "durationSec": 4.704
    },
    {
      "index": 54,
      "text": "حرك أصابعك.",
      "file": "c054.ogg",
      "durationSec": 3.888
    },
    {
      "index": 55,
      "text": "عندما تكون مستعدًا، افتح عينيك.",
      "file": "c055.ogg",
      "durationSec": 7.008
    },
    {
      "index": 56,
      "text": "احمل هذه الحرية معك.",
      "file": "c056.ogg",
      "durationSec": 5.232
    }
  ]
}
