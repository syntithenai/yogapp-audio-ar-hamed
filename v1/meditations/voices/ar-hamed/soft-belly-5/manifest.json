    {
      "index": 21,
      "text": "[وقفة: 25]",
      "file": "c021.ogg",
      "durationSec": 5.568
    },
    {
      "index": 22,
      "text": "ابق مع عشرة أنفاس هادئة ناعمة في البطن.",
