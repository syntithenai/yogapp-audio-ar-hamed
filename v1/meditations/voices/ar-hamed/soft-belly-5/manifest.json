      "durationSec": 7.2
    },
    {
      "index": 11,
      "text": "[وقفة: 20]",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "مرة أخرى. بطن ناعم في.",
      "file": "c012.ogg",
      "durationSec": 7.344
    },
    {
      "index": 13,
      "text": "بطن ناعم للخارج.",
      "file": "c013.ogg",
      "durationSec": 4.92
    },
    {
      "index": 14,
      "text": "[وقفة: 25]",
      "file": "c014.ogg",
      "durationSec": 5.568
    },
    {
      "index": 15,
      "text": "إذا كان العقل يجادل، دع الجسد يقود.",
      "file": "c015.ogg",
      "durationSec": 7.416
    },
    {
      "index": 16,
      "text": "توسع. يطلق.",
      "file": "c016.ogg",
      "durationSec": 5.472
    },
    {
      "index": 17,
      "text": "[وقفة: 29]",
      "file": "c017.ogg",
      "durationSec": 5.496
    },
    {
      "index": 18,
      "text": "انخفاض الكتفين.",
      "file": "c018.ogg",
      "durationSec": 4.416
    },
    {
      "index": 19,
      "text": "الفك ناعم.",
      "file": "c019.ogg",
      "durationSec": 3.648
    },
    {
      "index": 20,
      "text": "خالية من البطن.",
      "file": "c020.ogg",
      "durationSec": 4.272
