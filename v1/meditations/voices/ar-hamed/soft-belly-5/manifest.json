      "durationSec": 2.952
    },
    {
      "index": 1,
      "text": "ابحث عن مقعد مريح، أو استلقِ إذا كان ذلك أفضل.",
      "file": "c001.ogg",
      "durationSec": 8.928
    },
    {
      "index": 2,
      "text": "دع اليدين ترتاح.",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "تنعيم العينين، أو إغلاقهما.",
      "file": "c003.ogg",
      "durationSec": 6.216
    },
    {
      "index": 4,
      "text": "خذ نفسا بطيئا.",
      "file": "c004.ogg",
      "durationSec": 4.2
    },
    {
      "index": 5,
      "text": "وزفير أطول.",
      "file": "c005.ogg",
      "durationSec": 3.936
    },
    {
      "index": 6,
      "text": "ضع يدك على أسفل البطن إذا أردت.",
      "file": "c006.ogg",
      "durationSec": 6.168
    },
    {
      "index": 7,
      "text": "لاحظ ما إذا كان البطن متماسكًا.",
