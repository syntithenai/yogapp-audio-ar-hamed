  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.952
    },
    {
      "index": 1,
      "text": "خذ لحظة للوصول.",
      "file": "c001.ogg",
      "durationSec": 4.512
    },
    {
      "index": 2,
      "text": "ابحث عن مقعد مريح، أو استلقِ إذا كان ذلك أفضل.",
      "file": "c002.ogg",
      "durationSec": 8.928
    },
    {
      "index": 3,
      "text": "دع يديك ترتاح.",
      "file": "c003.ogg",
      "durationSec": 4.344
    },
    {
      "index": 4,
      "text": "اسمح لعينيك بإغلاق أو تخفيف نظرتك.",
      "file": "c004.ogg",
      "durationSec": 7.128
    },
    {
      "index": 5,
      "text": "لاحظ أنك هنا.",
      "file": "c005.ogg",
      "durationSec": 4.056
    },
    {
      "index": 6,
      "text": "لا شيء لإصلاحه الآن.",
      "file": "c006.ogg",
      "durationSec": 4.968
    },
    {
      "index": 7,
      "text": "لا شيء لإكمال.",
      "file": "c007.ogg",
      "durationSec": 4.128
    },
    {
      "index": 8,
      "text": "خذ نفسا بطيئا من خلال الأنف.",
      "file": "c008.ogg",
      "durationSec": 5.688
    },
    {
      "index": 9,
      "text": "وزفير أطول.",
      "file": "c009.ogg",
      "durationSec": 3.936
    },
    {
      "index": 10,
      "text": "مرة أخرى. شهيق ناعم.",
      "file": "c010.ogg",
      "durationSec": 7.44
    },
    {
      "index": 11,
      "text": "زفير لطيف.",
      "file": "c011.ogg",
      "durationSec": 4.032
    },
    {
      "index": 12,
      "text": "اشعر بوزن جسمك مدعومًا.",
      "file": "c012.ogg",
      "durationSec": 5.376
    },
    {
      "index": 13,
      "text": "الأرض، الكرسي، الأرض التي تحملك.",
      "file": "c013.ogg",
      "durationSec": 7.584
    },
    {
      "index": 14,
      "text": "إذا شردت الأفكار، فلا بأس.",
      "file": "c014.ogg",
      "durationSec": 6.288
    },
    {
      "index": 15,
      "text": "لاحظ ببساطة، ثم عد إلى هذا النفس.",
      "file": "c015.ogg",
      "durationSec": 7.272
    },
    {
      "index": 16,
      "text": "يستنشق. يصل.",
      "file": "c016.ogg",
      "durationSec": 5.832
    },
    {
      "index": 17,
      "text": "الزفير. يستقر.",
      "file": "c017.ogg",
      "durationSec": 6.024
    },
    {
      "index": 18,
      "text": "نفسًا سهلاً آخر.",
      "file": "c018.ogg",
      "durationSec": 4.32
    },
    {
      "index": 19,
      "text": "عندما تكون مستعدا، افتح عينيك.",
      "file": "c019.ogg",
      "durationSec": 7.008
    },
    {
      "index": 20,
      "text": "احمل هذا الهدوء معك.",
      "file": "c020.ogg",
      "durationSec": 4.68
    }
  ]
