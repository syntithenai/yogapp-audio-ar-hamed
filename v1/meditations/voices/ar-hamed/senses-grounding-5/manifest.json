  "totalSec": 171,
  "chunks": [
    {
      "index": 0,
      "text": "مرحباً.",
      "file": "c000.ogg",
      "durationSec": 2.952
    },
    {
      "index": 1,
      "text": "إذا شعرت بالتشتت أو النشاط، يمكن أن تساعدك هذه الممارسة.",
      "file": "c001.ogg",
      "durationSec": 10.44
    },
    {
      "index": 2,
      "text": "أبقِ أعينك مفتوحة الآن، إذا كان ذلك أكثر أمانًا.",
      "file": "c002.ogg",
      "durationSec": 9.504
    },
    {
      "index": 3,
      "text": "زرع كلا القدمين على الأرض.",
      "file": "c003.ogg",
      "durationSec": 5.28
    },
    {
      "index": 4,
      "text": "[وقفة: 17]",
      "file": "c004.ogg",
      "durationSec": 4.68
    },
    {
      "index": 5,
      "text": "اذكر خمسة أشياء يمكنك رؤيتها.",
      "file": "c005.ogg",
      "durationSec": 6.456
    },
    {
      "index": 6,
      "text": "بهدوء. خذ وقتك.",
      "file": "c006.ogg",
      "durationSec": 6.264
    },
    {
      "index": 7,
      "text": "[وقفة: 45]",
      "file": "c007.ogg",
      "durationSec": 5.592
    },
    {
      "index": 8,
      "text": "اذكر أربعة أشياء يمكنك الشعور بها أو لمسها.",
      "file": "c008.ogg",
      "durationSec": 7.992
    },
    {
      "index": 9,
      "text": "ملابس. كرسي. الهواء على الجلد. قدم على الأرض.",
      "file": "c009.ogg",
      "durationSec": 13.416
    },
    {
      "index": 10,
      "text": "[وقفة: 39]",
      "file": "c010.ogg",
      "durationSec": 5.376
    },
    {
      "index": 11,
      "text": "اذكر ثلاثة أصوات.",
      "file": "c011.ogg",
      "durationSec": 4.368
    },
    {
      "index": 12,
      "text": "قريب أو بعيد. ناعمة أو واضحة.",
      "file": "c012.ogg",
      "durationSec": 8.16
    },
    {
      "index": 13,
      "text": "[وقفة: 39]",
      "file": "c013.ogg",
      "durationSec": 5.376
    },
    {
      "index": 14,
      "text": "قم بتسمية رائحتين، أو ببساطة لاحظ جودة الهواء.",
      "file": "c014.ogg",
      "durationSec": 9.696
    },
    {
      "index": 15,
      "text": "[وقفة: 28]",
      "file": "c015.ogg",
      "durationSec": 5.904
    },
    {
      "index": 16,
      "text": "اذكر طعمًا واحدًا، أو الشعور داخل الفم.",
      "file": "c016.ogg",
      "durationSec": 7.992
    },
    {
      "index": 17,
      "text": "[وقفة: 23]",
      "file": "c017.ogg",
      "durationSec": 5.664
    },
    {
      "index": 18,
      "text": "أنت هنا. في هذا الجسد. في هذه الغرفة.",
      "file": "c018.ogg",
      "durationSec": 10.512
    },
    {
      "index": 19,
      "text": "تنفس لمدة أربعة.",
      "file": "c019.ogg",
      "durationSec": 4.512
    },
    {
      "index": 20,
      "text": "خارج لمدة ستة.",
      "file": "c020.ogg",
      "durationSec": 4.104
    },
    {
      "index": 21,
      "text": "[وقفة: 23]",
      "file": "c021.ogg",
      "durationSec": 5.664
    },
    {
      "index": 22,
      "text": "خذ نفسًا سهلاً آخر.",
      "file": "c022.ogg",
      "durationSec": 4.704
    },
    {
      "index": 23,
      "text": "تذبذب الأصابع.",
      "file": "c023.ogg",
      "durationSec": 3.912
    },
    {
      "index": 24,
      "text": "عندما تكون مستعدا، افتح عينيك.",
      "file": "c024.ogg",
      "durationSec": 7.008
    },
    {
      "index": 25,
      "text": "احمل القليل من هذا معك.",
      "file": "c025.ogg",
      "durationSec": 5.16
    }
  ]
}
