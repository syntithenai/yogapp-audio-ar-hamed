      "text": "[وقفة: 23]",
      "file": "c087.ogg",
      "durationSec": 5.664
    },
    {
      "index": 88,
      "text": "اشعر بالغرفة من حولك.",
      "file": "c088.ogg",
      "durationSec": 4.8
    },
    {
      "index": 89,
      "text": "أصوات قريبة وبعيدة.",
      "file": "c089.ogg",
      "durationSec": 5.16
    },
    {
      "index": 90,
      "text": "[وقفة: 21]",
      "file": "c090.ogg",
      "durationSec": 5.784
    },
    {
      "index": 91,
      "text": "تذبذب الأصابع.",
      "file": "c091.ogg",
      "durationSec": 3.912
    },
    {
      "index": 92,
      "text": "تذبذب أصابع القدم.",
      "file": "c092.ogg",
      "durationSec": 4.752
    },
    {
      "index": 93,
      "text": "قم بلف معصميك وكاحليك إذا أردت.",
