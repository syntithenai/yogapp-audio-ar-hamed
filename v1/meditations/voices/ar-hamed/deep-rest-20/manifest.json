      "text": "[وقفة: 115]",
      "file": "c084.ogg",
      "durationSec": 5.4
    },
    {
      "index": 85,
      "text": "ابدأ بملاحظة التنفس مرة أخرى.",
      "file": "c085.ogg",
      "durationSec": 6.24
