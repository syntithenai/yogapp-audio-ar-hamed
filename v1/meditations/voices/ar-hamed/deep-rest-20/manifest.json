      "durationSec": 9.024
    },
    {
      "index": 70,
      "text": "[وقفة: 55]",
      "file": "c070.ogg",
      "durationSec": 5.352
    },
    {
      "index": 71,
      "text": "إذا ظهرت فكرة، دعها تمر مثل السحابة.",
      "file": "c071.ogg",
      "durationSec": 7.632
    },
    {
      "index": 72,
      "text": "[وقفة: 50]",
      "file": "c072.ogg",
      "durationSec": 4.368
    },
    {
      "index": 73,
      "text": "العودة إلى الشعور بالاحتجاز.",
      "file": "c073.ogg",
      "durationSec": 5.712
    },
    {
      "index": 74,
      "text": "[وقفة: 55]",
      "file": "c074.ogg",
      "durationSec": 5.352
    },
    {
      "index": 75,
      "text": "الباقي هنا.",
      "file": "c075.ogg",
      "durationSec": 3.48
    },
    {
      "index": 76,
      "text": "لا شيء لحلها.",
      "file": "c076.ogg",
      "durationSec": 4.08
    },
    {
      "index": 77,
      "text": "لا شيء لإكمال.",
      "file": "c077.ogg",
      "durationSec": 4.128
    },
    {
      "index": 78,
      "text": "[وقفة:110]",
      "file": "c078.ogg",
      "durationSec": 4.992
    },
    {
      "index": 79,
      "text": "إذا انجرفت، فلا بأس.",
      "file": "c079.ogg",
      "durationSec": 5.208
    },
    {
      "index": 80,
      "text": "إذا بقيت على علم، فلا بأس بذلك أيضًا.",
      "file": "c080.ogg",
      "durationSec": 7.704
    },
    {
      "index": 81,
      "text": "كلاهما راحة.",
      "file": "c081.ogg",
      "durationSec": 3.696
    },
    {
      "index": 82,
      "text": "[وقفة: 130]",
