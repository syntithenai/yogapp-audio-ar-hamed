      "durationSec": 5.664
    },
    {
      "index": 64,
      "text": "استشعر الجسد كله كحقل واحد من السكون.",
      "file": "c064.ogg",
      "durationSec": 7.56
    },
    {
      "index": 65,
      "text": "يتحرك التنفس من خلاله مثل المد الهادئ.",
