  "totalSec": 550,
  "chunks": [
    {
      "index": 0,
      "text": "مرحبًا بكم في ممارسة الراحة العميقة.",
      "file": "c000.ogg",
      "durationSec": 6.792
    },
    {
      "index": 1,
      "text": "استلقي على ظهرك إذا استطعت.",
      "file": "c001.ogg",
      "durationSec": 5.544
    },
    {
      "index": 2,
      "text": "ادعم الرأس والركبتين إذا كان ذلك يساعد.",
      "file": "c002.ogg",
      "durationSec": 7.68
    },
    {
      "index": 3,
      "text": "دع ذراعيك تستريح بجانبك، وراحتي يديك ناعمة.",
      "file": "c003.ogg",
      "durationSec": 9.0
    },
    {
      "index": 4,
      "text": "أغلق العينين.",
      "file": "c004.ogg",
      "durationSec": 3.792
    },
    {
      "index": 5,
      "text": "لا يوجد مكان آخر لتكون فيه.",
      "file": "c005.ogg",
      "durationSec": 6.192
    },
    {
      "index": 6,
      "text": "[وقفة: 23]",
      "file": "c006.ogg",
      "durationSec": 5.664
    },
    {
      "index": 7,
      "text": "اشعر بنقاط التلامس مع الأرض أو السرير.",
      "file": "c007.ogg",
      "durationSec": 6.96
    },
    {
      "index": 8,
      "text": "الكعب. خَواصِر. شفرات الكتف. رأس.",
      "file": "c008.ogg",
      "durationSec": 12.192
    },
    {
      "index": 9,
      "text": "السماح للجسم بالاحتفاظ به.",
      "file": "c009.ogg",
      "durationSec": 5.4
    },
    {
      "index": 10,
      "text": "[وقفة: 23]",
      "file": "c010.ogg",
      "durationSec": 5.664
    },
    {
      "index": 11,
      "text": "لاحظ التنفس الطبيعي.",
      "file": "c011.ogg",
      "durationSec": 4.944
    },
    {
      "index": 12,
      "text": "لا حاجة لتغييره.",
      "file": "c012.ogg",
      "durationSec": 4.512
    },
    {
      "index": 13,
      "text": "يستنشق يصل.",
      "file": "c013.ogg",
      "durationSec": 4.032
    },
    {
      "index": 14,
      "text": "أوراق الزفير.",
      "file": "c014.ogg",
      "durationSec": 3.696
    },
    {
      "index": 15,
      "text": "[وقفة: 25]",
      "file": "c015.ogg",
      "durationSec": 5.568
    },
    {
      "index": 16,
      "text": "إذا كان العقل مشغولاً فهذا جائز.",
      "file": "c016.ogg",
      "durationSec": 6.432
    },
    {
      "index": 17,
      "text": "يمكنك الراحة على أي حال.",
      "file": "c017.ogg",
      "durationSec": 5.4
    },
    {
      "index": 18,
      "text": "ببساطة استمر في العودة إلى الإحساس.",
      "file": "c018.ogg",
      "durationSec": 6.912
    },
    {
      "index": 19,
      "text": "[وقفة: 23]",
      "file": "c019.ogg",
      "durationSec": 5.664
    },
    {
      "index": 20,
      "text": "جلب الوعي إلى القدم اليمنى.",
      "file": "c020.ogg",
      "durationSec": 5.184
    },
    {
      "index": 21,
      "text": "أصابع القدم. نعل. كعب.",
      "file": "c021.ogg",
      "durationSec": 8.832
    },
    {
      "index": 22,
      "text": "[وقفة: 21]",
      "file": "c022.ogg",
      "durationSec": 5.784
    },
    {
      "index": 23,
      "text": "أسفل الساق اليمنى.",
